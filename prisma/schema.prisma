generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model KnowledgeCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique
  points KnowledgePoint[]

  @@map("knowledge_categories")
}

model KnowledgePoint {
  id          Int               @id @default(autoincrement())
  title       String
  level       Int
  grade       Int
  content     String           @db.Text
  order_index Int
  category    KnowledgeCategory @relation(fields: [category_id], references: [id])
  category_id Int
  parent      KnowledgePoint?   @relation("ParentChild", fields: [parent_id], references: [id])
  parent_id   Int?
  children    KnowledgePoint[]  @relation("ParentChild")
  progress    UserKnowledgeProgress[]

  @@map("knowledge_points")
}

model UserKnowledgeProgress {
  id                Int           @id @default(autoincrement())
  user_id          String        // 用户ID
  knowledge_point   KnowledgePoint @relation(fields: [knowledge_point_id], references: [id])
  knowledge_point_id Int
  completed_times   Int           @default(0) // 完成次数，默认0，最多4次
  last_completed_at DateTime?     // 最后一次完成时间，可以为空
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@unique([user_id, knowledge_point_id])
  @@map("user_knowledge_progress")
}
